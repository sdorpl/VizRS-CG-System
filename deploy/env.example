# Skopiuj jako deploy/.env (nie commituj!) i uzupełnij.

# Domena VPS (rekord DNS A/AAAA musi wskazywać na serwer)
VIZRS_DOMAIN=cg.example.pl

# Token operatora: długi, losowy, znaki A-Z a-z 0-9 - _ .  (np. `openssl rand -hex 24`)
VIZRS_TOKEN=ZMIEN_MNIE

# Token wyjścia – tylko do odczytu (/output dla OBS, vMix). Wyciek adresu wyjścia nie daje sterowania anteną.
VIZRS_OUTPUT_TOKEN=ZMIEN_MNIE_TEZ

# Opcjonalnie: webhook zdarzeń onAir/offAir/error (http://host:port/ścieżka)
# VIZRS_WEBHOOK=http://10.0.0.5:9000/vizrs
